# ==============================================================================
# 🚨 SEGURANÇA MÁXIMA E VARIÁVEIS DE AMBIENTE (NUNCA COMITAR ISSO)
# ==============================================================================
# Arquivos de ambiente (Senhas, chaves do Supabase, APIs)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Chaves de criptografia e certificados SSL
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Arquivos de credenciais de serviços (Google, AWS, Firebase, etc)
secrets.json
client_secret.json
credentials.json
auth.json
gcp-key.json

# Configurações de gerenciadores de pacotes (podem conter tokens de acesso privados)
.npmrc
.yarnrc

# Cloudflare e Servidores locais
.dev.vars
*.local

# ==============================================================================
# 📦 DEPENDÊNCIAS
# ==============================================================================
node_modules/
.pnp
.pnp.js
.pnp.cjs

# ==============================================================================
# 🏗️ BUILD E SAÍDAS (GERADOS AUTOMATICAMENTE)
# ==============================================================================
dist/
dist-ssr/
build/
out/
.output/
.nitro/
coverage/
.nyc_output/

# ==============================================================================
# 🗄️ LOGS E DEBUGGING
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
